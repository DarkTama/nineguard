--- a/web/static/styles/main.css
+++ b/web/static/styles/main.css
@@ -912,6 +912,19 @@
 .badge.removed-tag { height: 15px; padding: 0 5px; margin-left: 6px; font-size: 9.5px; font-weight: 600; text-transform: lowercase; }
 .table tr.row-removed td { opacity: .62; }
 .table tr.row-removed td:last-child { opacity: 1; }
+/* Quotas (ADR 0007) */
+.qbar { display: inline-block; vertical-align: middle; width: 110px; height: 6px; margin-right: 6px; border-radius: 3px; background: var(--hover); overflow: hidden; }
+.qbar > i { display: block; height: 100%; background: var(--ok); }
+.qbar.warn > i { background: var(--lv-warn); }
+.qbar.err > i { background: var(--danger); }
+.qpct { font-weight: 700; font-variant-numeric: tabular-nums; }
+.qpct.warn { color: var(--lvt-warn); }
+.qpct.err { color: var(--danger); }
+.qrow-sub { margin-top: 4px; font-size: 11px; }
+.qrow-inactive td { opacity: .55; }
+.qrow-inactive td:last-child { opacity: 1; }
+.quota-card { border-color: color-mix(in srgb, var(--lv-warn) 40%, var(--border)); }
+.quota-card .card-head h3 { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 14px; }
 .removed-card { border-color: color-mix(in srgb, var(--lv-warn) 40%, var(--border)); }
 .removed-card .card-head h3 { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 14px; }
 .removed-body { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
